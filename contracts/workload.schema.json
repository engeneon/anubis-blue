{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:anubis:workload:1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "stages",
    "scenarios"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "type": "string"
    },
    "tenancy": {
      "enum": [
        "single",
        "multi"
      ]
    },
    "objective": {
      "const": "gpu_count"
    },
    "candidate_limit": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4096
    },
    "stages": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "observations"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "observations": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "state"
              ],
              "properties": {
                "state": {
                  "enum": [
                    "known",
                    "estimated",
                    "assumed",
                    "unknown"
                  ]
                },
                "value": {
                  "type": "string",
                  "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
                },
                "unit": {
                  "type": "string"
                },
                "origin": {
                  "enum": [
                    "customer",
                    "measurement",
                    "template",
                    "agent"
                  ]
                },
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "accepted": {
                  "type": "boolean"
                },
                "active": {
                  "type": "boolean"
                },
                "reason": {
                  "type": "string"
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "state": {
                        "const": "unknown"
                      }
                    }
                  },
                  "then": {
                    "not": {
                      "required": [
                        "value"
                      ]
                    }
                  },
                  "else": {
                    "required": [
                      "value",
                      "unit",
                      "origin",
                      "source"
                    ]
                  }
                }
              ]
            }
          },
          "planning": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "model": {
                "type": "string"
              },
              "parallel_gpus": {
                "type": "integer"
              },
              "concurrent_sequences": {
                "type": "integer"
              },
              "context_tokens": {
                "type": "integer"
              },
              "weight_bytes": {
                "type": "string"
              },
              "kv_bytes": {
                "type": "string"
              },
              "workspace_GB": {
                "type": "string"
              },
              "training_bytes_per_parameter": {
                "type": "string"
              },
              "activation_GB_per_gpu": {
                "type": "string"
              },
              "host_ram_GB_per_gpu": {
                "type": "string"
              },
              "local_disk_GB_per_gpu": {
                "type": "string"
              },
              "cpu_cores_per_gpu": {
                "type": "integer"
              }
            },
            "required": [
              "model",
              "parallel_gpus",
              "concurrent_sequences",
              "context_tokens",
              "weight_bytes",
              "kv_bytes",
              "workspace_GB",
              "training_bytes_per_parameter",
              "activation_GB_per_gpu",
              "host_ram_GB_per_gpu",
              "local_disk_GB_per_gpu",
              "cpu_cores_per_gpu"
            ]
          }
        }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "active_stages": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "multiplier": {
            "type": "string"
          },
          "failed_nodes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 64
          },
          "cache_state": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          }
        }
      }
    },
    "planning": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "architecture": {
          "type": "string"
        },
        "sensitivity_percent": {
          "type": "string"
        },
        "compute_efficiency": {
          "type": "string"
        },
        "memory_efficiency": {
          "type": "string"
        },
        "minimum_service_fraction": {
          "type": "string"
        },
        "accept_capacity_shortfall": {
          "type": "boolean"
        },
        "bytes_per_token": {
          "type": "string"
        },
        "protocol_allowance": {
          "type": "string"
        },
        "assumptions_accepted": {
          "type": "boolean"
        },
        "expansion_lead_days": {
          "type": "integer"
        },
        "source": {
          "type": "string"
        }
      },
      "required": [
        "architecture",
        "sensitivity_percent",
        "compute_efficiency",
        "memory_efficiency",
        "minimum_service_fraction",
        "accept_capacity_shortfall",
        "bytes_per_token",
        "protocol_allowance",
        "assumptions_accepted",
        "expansion_lead_days",
        "source"
      ]
    },
    "characterization": {
      "type": "object"
    }
  }
}
